    "Nomai Archives": "挪麦档案馆"
  },

  "DialogueDictionary": {
    // == Festival Area ==
    // -- Main Dialogues --
    // Callis
    "$CALLISTHESIS_CALLIS_NAME": "卡莉丝",
    "$CALLISTHESIS_CALLIS_DEFAULT": "哦不……这下糟了……真的糟透了……",
    "$CALLISTHESIS_CALLIS_DEFAULT_CHOICE_HI": "你好？",
    "$CALLISTHESIS_CALLIS_DEFAULT_CHOICE_THESIS": "嘿，我想这是你掉的。",

    "$CALLISTHESIS_CALLIS_POSTINITIAL": "这下糟了……真的糟透了……\n你找到卷轴了吗？",
    "$CALLISTHESIS_CALLIS_POSTINITIAL_CHOICE_THESIS": "找到了，给你。",
    "$CALLISTHESIS_CALLIS_POSTINITIAL_CHOICE_NO": "还没呢。",
    "$CALLISTHESIS_CALLIS_POSTINITIAL_CHOICE_PASSWORD": "没有，我需要密码才能获取它。",
    "$CALLISTHESIS_CALLIS_POSTINITIAL_CHOICE_REM": "我再问一下，我要找的是什么来着？",

    "$CALLISTHESIS_CALLIS_POSTPASSWORD": "这下糟了……真的糟透了……\n你找到卷轴了吗？",
    "$CALLISTHESIS_CALLIS_POSTPASSWORD_CHOICE_THESIS": "找到了，给你。",
    "$CALLISTHESIS_CALLIS_POSTPASSWORD_CHOICE_NO": "还没呢。",
    "$CALLISTHESIS_CALLIS_POSTPASSWORD_CHOICE_PASSWORDREM": "能再提醒我一下密码线索吗？",
    "$CALLISTHESIS_CALLIS_POSTPASSWORD_CHOICE_REM": "我再问一下，我要找的是什么来着？",

    "$CALLISTHESIS_CALLIS_ENDDIALOGUE": "请快点……",

    "$CALLISTHESIS_CALLIS_ENDING_FAST": "等等，这是……",
    "$CALLISTHESIS_CALLIS_ENDING_SLOW_1": "希望拿回来的过程没太费劲。",
    "$CALLISTHESIS_CALLIS_ENDING_SLOW_1_CHOICE_POS": "没事，我还学到了不少东西。",
    "$CALLISTHESIS_CALLIS_ENDING_SLOW_1_CHOICE_NEG": "我再也不想听到任何关于bukrads的事了。",
    "$CALLISTHESIS_CALLIS_ENDING_SLOW_2": "哦，听你这么说我很抱歉……不过不管怎么说……",
    "$CALLISTHESIS_CALLIS_ENDING_BASE": "太谢谢你了朋友！你真是我的救星！",

    "$CALLISTHESIS_CALLIS_INITIAL_1": "哦你好！我叫卡莉丝。我好像没见过你？",
    "$CALLISTHESIS_CALLIS_INITIAL_1_REPLY": "怎么了？你看起来好像在担心什么。",
    "$CALLISTHESIS_CALLIS_INITIAL_2": "哦，这个嘛……呃……有点不好意思。\n你看，今天对我来说是个大日子。这是我第一次在发现节上发表成果，我马上要向其他挪麦人展示我的论文了。",
    "$CALLISTHESIS_CALLIS_INITIAL_2_REPLY": "这不是好事吗？",
    "$CALLISTHESIS_CALLIS_INITIAL_3": "嗯，是好事，但我……可能把卷轴弄丢了？\n没有它我没法展示论文啊。在大家面前我肯定会像个傻瓜一样，这太糟糕了！",
    "$CALLISTHESIS_CALLIS_INITIAL_3_CHOICE_HELP": "或许我能帮上忙？",
    "$CALLISTHESIS_CALLIS_INITIAL_3_CHOICE_LEAVE": "哦，那肯定会很有意思。到时候见！",
    "$CALLISTHESIS_CALLIS_INITIAL_4_1": "我已经到处都找过了，所以我觉得你可能也……",
    "$CALLISTHESIS_CALLIS_INITIAL_4_2": "等等……",
    "$CALLISTHESIS_CALLIS_INITIAL_4_3": "对了！我记得我在档案馆存了一份备份（就怕发生这种事）。\n如果能拿到那份备份，我就能展示论文了。\n你能行行好帮我去拿一下吗？",
    "$CALLISTHESIS_CALLIS_INITIAL_4_CHOICE_POS": "听起来可以。",
    "$CALLISTHESIS_CALLIS_INITIAL_4_CHOICE_NEG": "无意冒犯，但你不能自己去拿吗？",
    "$CALLISTHESIS_CALLIS_INITIAL_5": "恐怕我得留在这儿。我还有些东西要准备，而且我走了的话大家会注意到的。",
    "$CALLISTHESIS_CALLIS_INITIAL_5_REPLY": "有道理。那你需要的是哪份卷轴？",
    "$CALLISTHESIS_CALLIS_INITIAL_6": "谢谢你，你真是我的救命恩人！我记得它应该是以我的名字存档的，“卡莉丝#001-论文”。\n如果你没去过的话，档案馆在北极。",
    "$CALLISTHESIS_CALLIS_INITIAL_6_REPLY": "我会带着它回来的。",
    "$CALLISTHESIS_CALLIS_INITIAL_REM": "我在档案馆的论文卷轴，我记得应该是以我的名字存档的，“卡莉丝#001-论文”。\n如果你没去过的话，档案馆在北极。",
    "$CALLISTHESIS_CALLIS_INITIAL_REM_REPLY": "我会带着它回来的。",

    "$CALLISTHESIS_CALLIS_PASSWORD_1": "哦，对了。我忘了这茬了。\n我设置了密码，这样我的研究成果的第一批观众就只会在我的展示会上。\n我发誓，仪式结束后我就会取消密码的！",
    "$CALLISTHESIS_CALLIS_PASSWORD_1_REPLY": "那密码是什么？我们现在就得要，在仪式开始<![CDATA[<i>之前</i>]]>。",
    "$CALLISTHESIS_CALLIS_PASSWORD_2_1": "当然了。让我想想。密码是……",
    "$CALLISTHESIS_CALLIS_PASSWORD_2_2": "是……",
    "$CALLISTHESIS_CALLIS_PASSWORD_2_REPLY": "你该不会连密码也忘了吧？",
    "$CALLISTHESIS_CALLIS_PASSWORD_3_1": "没有！\n……\n可能有点记不清了。但我有个便条用来记密码，你看！",
    "$CALLISTHESIS_CALLIS_PASSWORD_3_2": "“嘿，我自己！你可能又忘了密码了，所以我写了这个秘密便条来帮你记起来！”",
    "$CALLISTHESIS_CALLIS_PASSWORD_3_3": "“密码的第一部分是父母带你去参加第一次发现节时你的年龄。”",
    "$CALLISTHESIS_CALLIS_PASSWORD_3_4": "“密码的第二部分是档案馆的广播信号（假设自从我设置密码后它没改过）。”",
    "$CALLISTHESIS_CALLIS_PASSWORD_3_5": "“密码的第三部分是红腹角布克拉德的腿的数量。”",
    "$CALLISTHESIS_CALLIS_PASSWORD_3_REPLY": "我一点都没听懂。",
    "$CALLISTHESIS_CALLIS_PASSWORD_4_1": "嗯，我把它设得复杂点是为了保证密码的安全。",
    "$CALLISTHESIS_CALLIS_PASSWORD_4_2": "第一部分是10。我永远都忘不了第一次参加发现节的那天。我认识了好多人，还学到了好多神奇的东西！",
    "$CALLISTHESIS_CALLIS_PASSWORD_4_REPLY": "那剩下的呢？",
    "$CALLISTHESIS_CALLIS_PASSWORD_5": "这个嘛……",
    "$CALLISTHESIS_CALLIS_PASSWORD_5_REPLY": "你忘了？",
    "$CALLISTHESIS_CALLIS_PASSWORD_6": "我忘了。",
    "$CALLISTHESIS_CALLIS_PASSWORD_6_REPLY": "我就知道。",
    "$CALLISTHESIS_CALLIS_PASSWORD_7": "祝你好运？",
    "$CALLISTHESIS_CALLIS_PASSWORD_7_CHOICE_POS": "谢谢，大概吧。",
    "$CALLISTHESIS_CALLIS_PASSWORD_7_CHOICE_NEG": "知道吗，我还是先去别的星球探险吧。",
    "$CALLISTHESIS_CALLIS_PASSWORD_REM_1": "当然，是这样的：\n“嘿，我自己！你可能又忘了密码了，所以我写了这个秘密便条来帮你记起来！”",
    "$CALLISTHESIS_CALLIS_PASSWORD_REM_2": "“密码的第一部分是父母带你去参加第一次发现节时你的年龄。”",
    "$CALLISTHESIS_CALLIS_PASSWORD_REM_3": "“密码的第二部分是档案馆的广播信号（假设自从我设置密码后它没改过）。”",
    "$CALLISTHESIS_CALLIS_PASSWORD_REM_4": "“密码的第三部分是红腹角布克拉德的腿的数量。”",
    "$CALLISTHESIS_CALLIS_PASSWORD_REM_REPLY": "10，广播信号，布克拉德的腿，记下了。",

