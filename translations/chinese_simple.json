    "$CALLISTHESIS_FRONTDESKGUARD_NAME": "卡尼亚",
    "$CALLISTHESIS_FRONTDESKGUARD_DEFAULT": "请排队等候。",
    "$CALLISTHESIS_FRONTDESKGUARD_DEFAULT_REPLY": "但这事很紧急！",
    "$CALLISTHESIS_FRONTDESKGUARD_REFUSAL": "我们会尽力为所有人提供服务。请从后面的售票机拿一张票，然后等候叫号。",
    "$CALLISTHESIS_FRONTDESKGUARD_POSTREFUSAL": "请从后面的售票机拿一张票，然后等候叫号。",
    "$CALLISTHESIS_FRONTDESKGUARD_LUNCHBREAK": "我们的前台工作人员正在午休，但你可以使用自动助手。",

    // Ticket dispenser
    "$CALLISTHESIS_TICKETDISPENSER_BASE": "当前叫号#F102。",
    "$CALLISTHESIS_TICKETDISPENSER_BASE_CHOICE_CHECK": "*查看我的票*",
    "$CALLISTHESIS_TICKETDISPENSER_BASE_CHOICE_GRAB": "*拿一张票*",
    "$CALLISTHESIS_TICKETDISPENSER_BASE_CHOICE_GRABALL": "*把所有票都拿走*",
    "$CALLISTHESIS_TICKETDISPENSER_EXIT": "感谢您的耐心等待。",
    "$CALLISTHESIS_TICKETDISPENSER_TICKET1_GRAB": "已出票#K594。预计等待时间2小时12分钟。",
    "$CALLISTHESIS_TICKETDISPENSER_TICKET1_CHECK": "您的票是#K594。预计等待时间2小时12分钟。",
    "$CALLISTHESIS_TICKETDISPENSER_TICKET2_GRAB": "已出票#P771。预计等待时间3小时42分钟。",
    "$CALLISTHESIS_TICKETDISPENSER_TICKET2_CHECK": "您的票是#P771。预计等待时间3小时42分钟。",
    "$CALLISTHESIS_TICKETDISPENSER_TICKET3_GRAB": "已出票#D401。预计等待时间45分钟。",
    "$CALLISTHESIS_TICKETDISPENSER_TICKET3_CHECK": "您的票是#D401。预计等待时间45分钟。",
    "$CALLISTHESIS_TICKETDISPENSER_TICKET4_GRAB": "已出票#Z999。预计等待时间36亿年。",
    "$CALLISTHESIS_TICKETDISPENSER_TICKET4_CHECK": "您的票是#Z999。预计等待时间36亿年。",
    "$CALLISTHESIS_TICKETDISPENSER_TICKET5_GRAB": "已出票#U816。预计等待时间64天。",
    "$CALLISTHESIS_TICKETDISPENSER_TICKET5_CHECK": "您的票是#U816。预计等待时间64天。",
    "$CALLISTHESIS_TICKETDISPENSER_GRABALL": "*在这些票里，你找到了#A103号票*",
    "$CALLISTHESIS_TICKETDISPENSER_DEPLETED_1": "当前叫号#A103。\n警告！本机已无纸，无法再出票。请通知附近的工作人员补充纸张。",
    "$CALLISTHESIS_TICKETDISPENSER_DEPLETED_1_REPLY": "*查看我的票*",
    "$CALLISTHESIS_TICKETDISPENSER_DEPLETED_2": "您的票是#A103。可以去前台办理了。",
    "$CALLISTHESIS_TICKETDISPENSER_DEPLETED_2_REPLY": "终于。",

    // Aster (The goat rambles a lot)
    "$CALLISTHESIS_ASTER_NAME": "埃斯特",
    "$CALLISTHESIS_ASTER_DEFAULT": "早上好啊，亲爱的。",
    "$CALLISTHESIS_ASTER_DEFAULT_CHOICE_HI": "早上好，夫人。",
    "$CALLISTHESIS_ASTER_DEFAULT_CHOICE_CUTLINE": "抱歉夫人，我赶时间，能让我插到前面吗？",
    "$CALLISTHESIS_ASTER_DEFAULT_CHOICE_BUKRAD": "打扰一下夫人，您碰巧知道关于布克拉德的事吗？",

    "$CALLISTHESIS_ASTER_CUTLINE_1_1": "打扰一下？真是太无礼了！哪有这么跟老人家说话的！",
    "$CALLISTHESIS_ASTER_CUTLINE_1_2": "连招呼都不打就想插队。现在的年轻人啊！",
    "$CALLISTHESIS_ASTER_CUTLINE_1_3": "我们那时候，都会耐心排队，表现得像个有教养的挪麦人。我们甚至会把位置让给长辈。",
    "$CALLISTHESIS_ASTER_CUTLINE_1_4": "我记得我6岁那年，有个老先生走进沙拉店。所有人都让开，让他先点单。那时候我们多有礼貌啊。那位老先生甚至都不用付钱，员工们太有礼貌了。",
    "$CALLISTHESIS_ASTER_CUTLINE_1_5": "不过说真的，这跟他是店主一点关系都没有。",
    "$CALLISTHESIS_ASTER_CUTLINE_2_1": "哦，我以前可喜欢那家沙拉餐厅了。是叫“沙拉宫”来着吗？我这只老山羊在那儿待过好多天呢。",
    "$CALLISTHESIS_ASTER_CUTLINE_2_2": "他们的生菜配樱桃番茄真是美味极了。到现在我都想知道他们是怎么把蔬菜种得那么熟的。",
    "$CALLISTHESIS_ASTER_CUTLINE_2_3": "是自家种的，还是有专门的供应商？现在的年轻人都觉得理所当然，但新鲜的食材真的能做出好味道。",
    "$CALLISTHESIS_ASTER_CUTLINE_3_1": "你知道吗，我自己也试过种菜？",
    "$CALLISTHESIS_ASTER_CUTLINE_3_2": "我家房子后面有块绝佳的菜地。阳光充足，特别适合植物生长。我还买了新的工装裤，全身心投入到园艺中。",
    "$CALLISTHESIS_ASTER_CUTLINE_3_3": "呵呵，小伙子们看到我这只小山羊穿着园艺服有多可爱，肯定会心动的。不过可惜啊，我得专心照顾我的植物。",
    "$CALLISTHESIS_ASTER_CUTLINE_4_1": "我还读了很多书来学习怎么种好。亲爱的，你也该多读书，不然都不知道自己错过了什么知识。",
    "$CALLISTHESIS_ASTER_CUTLINE_4_2": "我的眼睛不太好使了，但睡前还是喜欢看会儿卷轴。有时候我亲爱的特穆会好心地给我读，我就能安安稳稳睡着了。",
    "$CALLISTHESIS_ASTER_CUTLINE_4_3": "你们年轻人喜欢轰轰烈烈地生活，但总有一天会明白，安稳下来也是一种福气。",
    "$CALLISTHESIS_ASTER_CUTLINE_CHOICE_LISTEN": "……",
    "$CALLISTHESIS_ASTER_CUTLINE_CHOICE_LEAVE": "*离开*",
    "$CALLISTHESIS_ASTER_CUTLINE_CHOICE_SNOOZE": "*zzz*",
    "$CALLISTHESIS_ASTER_CUTLINE_CHOICE_QUESTION": "那您来这儿是做什么呢，夫人？",
    "$CALLISTHESIS_ASTER_CUTLINE_5_1": "哦，是那些档案管理员，连左右都分不清。\n有人告诉我有些卷轴出现了损坏问题。",
    "$CALLISTHESIS_ASTER_CUTLINE_5_2": "所以他们就把我这只老山羊叫来，想让我修复一下，把缺失的数据重写出来。\n我好多作品都存在这儿呢，我可不想因为某个不懂怎么处理卷轴的顽固分子而把它们弄丢了。",
    "$CALLISTHESIS_ASTER_CUTLINE_5_3": "我这把老骨头站这么久可受不了，我想去找个地方坐会儿。\n谢谢你陪我聊这么久，亲爱的。",
    "$CALLISTHESIS_ASTER_CUTLINE_5_REPLY": "不客气，夫人。",
    "$CALLISTHESIS_ASTER_CUTLINE_6": "来，你急着赶路，这张票给你吧。\n等我腿歇过来了再去拿一张。",
    "$CALLISTHESIS_ASTER_CUTLINE_6_REPLY": "谢谢您，夫人。您多保重。",

    "$CALLISTHESIS_ASTER_BUKRAD_1": "当然知道了，我可是布克拉德专家。\n我来这儿就是因为这个，他们叫我来修复一份损坏的卷轴，重写缺失的数据。",
    "$CALLISTHESIS_ASTER_BUKRAD_1_REPLY": "哦，那真是太好了。我想知道红腹角布克拉德有多少条腿。",
    "$CALLISTHESIS_ASTER_BUKRAD_2": "呵呵，这请求可真特别。亲爱的，你是想跟我这老太太开玩笑吗？",
    "$CALLISTHESIS_ASTER_BUKRAD_2_REPLY": "不是……您为什么会这么想？",
    "$CALLISTHESIS_ASTER_BUKRAD_3": "亲爱的，这些布克拉德在它们的同类中很有名，因为它们是唯一没有腿的。",
    "$CALLISTHESIS_ASTER_BUKRAD_3_REPLY": "哦。什么？我是说，好吧但——行吧。",
    "$CALLISTHESIS_ASTER_BUKRAD_4": "一切都还好吗，亲爱的？",
    "$CALLISTHESIS_ASTER_BUKRAD_4_REPLY": "是-是啊，我只是觉得我本可以早点知道这个的。谢谢您，夫人。",

    // Frontdesk recorder
    "$CALLISTHESIS_FRONTDESK_CHOICE_PRESS1": "*按1*",
    "$CALLISTHESIS_FRONTDESK_CHOICE_PRESS2": "*按2*",
